# Copy to .env and adjust. Every value below is also the built-in default.
PORT=4000
DATABASE_URL=postgres://localhost:5432/cetizion_tracker
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# ---------------------------------------------------------------- sign-in
# Who the API checks a sign-in against.
#
#   shared    AUTH_USERNAME / AUTH_PASSWORD below. One account, exactly as
#             the tracker has always worked. THIS IS THE DEFAULT, and
#             deploying new code without setting AUTH_MODE changes nothing.
#   database  an email and password in the users table (#18).
#
# The two never help each other out. In database mode the shared password
# is not a fallback; in shared mode a users row is not a second way in.
# Sessions are likewise not interchangeable, so switching mode signs
# everyone out — which is the intended behaviour at the cutover, and the
# reason not to flip this casually.
#
# AUTH_MODE=database refuses to start unless at least one users row has
# role=admin and active=true. Otherwise nobody could sign in, including
# whoever would create the first account. Use BOOTSTRAP_ADMIN_* below (or
# `npm run bootstrap`) to create that admin BEFORE switching. Bootstrapping
# is not signing in: it fills the users table and nothing else.
#
# An unrecognised value stops the start rather than falling back.
#
# Before switching, run the read-only readiness check — it answers "would
# database mode start, and could anybody sign in?" while the answer is
# still cheap, and prints no secrets:
#
#   npm --prefix server run auth:check
#
# The full procedure, including the rollback, is in
# docs/issue-18-auth-cutover.md. Rolling back is this variable and a
# restart; nothing in the database changes either way.
AUTH_MODE=shared

# Used by shared mode only. AUTH_PASSWORD and SESSION_SECRET are REQUIRED
# when NODE_ENV=production — the API refuses to start without them rather
# than come up unlocked. In development both fall back so `npm run dev`
# just works.
AUTH_USERNAME=admin
AUTH_PASSWORD=
# Signs the session cookie. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
SESSION_SECRET=
# How long a sign-in lasts before it has to be repeated.
SESSION_TTL_HOURS=12

# ------------------------------------------------------- first admin (#18)
# Optional. Creates the first row in the users table. It does NOT change how
# anyone signs in — bootstrapping fills a row and is never consulted when
# somebody signs in. What the row is FOR depends on AUTH_MODE above: in the
# default shared mode the account cannot yet be used to sign in and is being
# put in place for the cutover; in database mode it is a real account.
#
# Set all three together, or none of them:
#   none set      nothing happens, and that is the normal state today
#   all three set the FIRST admin is created, then left alone — a restart
#                 never resets its password, name or role
#   some set      the API refuses to start, because a half-set secret is a
#                 deployment that went wrong, not a reason to do nothing
#
# It only ever fills an empty seat. Once any admin who can sign in exists,
# this does nothing at all — changing BOOTSTRAP_ADMIN_EMAIL later does NOT
# create a second administrator. Adding more admins is a deliberate act
# inside the app, not an environment variable.
#
# Where it will not act it will not improvise: if the address already
# belongs to somebody — an account that is switched off, or one that is not
# an admin — nothing is reactivated, promoted or given a new password. The
# API logs a warning and starts anyway, because a stale variable should not
# cost you a working tracker. Only the variables themselves being wrong
# (half set, not an address, a password under 12 characters) stops the
# start. Whether anybody can actually sign in is checked separately, and
# only refuses to start in AUTH_MODE=database.
#
# The password is hashed (scrypt) before it is stored and is never logged.
# At least 12 characters. Runs after the migrations when the container
# starts; `npm run bootstrap` does the same thing by hand.
#
# REMOVE ALL THREE once the first admin exists and somebody has signed in
# as them. They are for creating or recovering that first account, not for
# ongoing authentication: leaving a usable admin password sitting in the
# production environment is a standing credential nobody rotates, and the
# variables do nothing there once the seat is filled. See
# docs/issue-18-auth-cutover.md.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ------------------------------------------------------------- deployment
# `secure` cookies default to on in production, which means the browser will
# only send them over HTTPS. Set to false only if the app is served over
# plain HTTP — sign-in silently fails otherwise.
COOKIE_SECURE=true
# Number of reverse proxies in front of the API (Traefik, nginx, a load
# balancer). Leave at 0 when there is none: trusting a proxy that is not
# there lets a caller forge their own IP and slip past the sign-in limiter.
# Set it to 1 on any deployment behind Dokploy or Traefik — which is every
# deployed environment. Left at 0 there, every request looks like it comes
# from the proxy: one client refreshing an acceptance link exhausts the
# public rate limit for all of them, the sign-in lockout locks out the whole
# company, and the IP stored as evidence on an acceptance is the proxy's.
# The API logs a warning on the first forwarded request if this is wrong.
TRUST_PROXY=0
# Where the built front end lives. Defaults to ../web/dist.
WEB_DIST_DIR=

# -------------------------------------------------------------- documents
# Quotations and POs can carry an uploaded document, stored in Cloudinary
# (Console → Settings → API Keys). Until all three are set, uploads are
# refused; everything else works as before.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Top folder for this app's files. Use another one locally, e.g.
# cetizion-tracker-dev, so test uploads never mix with production files.
CLOUDINARY_FOLDER=cetizion-tracker
# Largest file accepted, in MB. Cloudinary's Free plan caps files at 10.
DOCUMENT_MAX_MB=10

# ------------------------------------------------------------------ dates
# Where the business is. The year in reference numbers (CTZ/QT/2026/…) and
# the date on a quotation created from a won enquiry follow this zone, not
# the server's clock, which is UTC in the container.
BUSINESS_TIME_ZONE=Asia/Kolkata

# ------------------------------------------------------------------ email
# Outgoing email: payment reminders, the finance digest, test emails.
# EMAIL_MODE=log     nothing is sent; every email is written to the log only (default)
# EMAIL_MODE=sandbox only addresses on EMAIL_ALLOWLIST receive mail (use on staging)
# EMAIL_MODE=live    sent over SMTP
EMAIL_MODE=log
EMAIL_ALLOWLIST=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Cetizion Tracker <tracker@cetizionverifica.com>
EMAIL_REPLY_TO=
EMAIL_BCC=

# ------------------------------------------------------------ mailboxes (#29)
# Microsoft 365 mail sync. Register an app in Microsoft Entra ID with the
# delegated permissions offline_access, User.Read, Mail.ReadWrite and
# Mail.Send, and this redirect URI. MAIL_TOKEN_KEY encrypts the stored
# tokens: a long random string (openssl rand -base64 32); never change it
# once mailboxes are connected, or they must be connected again.
# MAIL_WEBHOOK_URL is the public https address of /api/mail/notifications;
# without it, mail arrives on the five-minute sweep instead of at once.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=https://tracker.example.com/api/mailboxes/oauth/microsoft
MS_APP_ONLY=false
MAIL_WEBHOOK_URL=
MAIL_TOKEN_KEY=

# --------------------------------------------------- sign in with a provider (C18)
# Only in AUTH_MODE=database: a provider signs somebody into a users row an
# admin has already added and left active, and never creates one. Leave any
# of these blank and that button is not drawn at all.
#
# Microsoft reuses the Entra app above — add the delegated permissions
# openid, email and profile, and add THIS redirect URI alongside the
# mailbox one. Keeping them separate is deliberate: a consent granted for
# reading mail must not come back as a sign-in.
MS_SIGNIN_REDIRECT_URI=
# Google needs a new OAuth client (Google Cloud console, "Web application").
# Restrict it to your workspace domain there as well as here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ------------------------------------------------------------ webhooks (#49)
# Shared secret for signed enquiries posted to /api/hooks/enquiries (also
# switch incoming_enquiries_enabled on in Settings). Leave blank to refuse all.
INCOMING_WEBHOOK_SECRET=

# ------------------------------------------------------------ accounting (#48)
# Set accounting_provider in Settings to zoho, tally or file. Without these,
# export files from either system can still be uploaded on the Accounting page.
# Zoho Books: a self-client in the Zoho API console, scope ZohoBooks.fullaccess.all,
# a refresh token from it, and the organisation id. ZOHO_DC is in for India.
ZOHO_DC=in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
# Tally Prime with its HTTP server on (F1 > Settings > Connectivity), reached
# through a tunnel, e.g. http://tally-tunnel.internal:9000
TALLY_URL=

# ------------------------------------------------------------ monitoring (#38)
# Error tracking: a Sentry or self-hosted GlitchTip project DSN. Nothing is
# sent without it. RELEASE is the deployed commit (Dokploy: SOURCE_COMMIT).
SENTRY_DSN=
APP_ENV=production
RELEASE=
# Who gets alert emails when the alert_email setting is blank.
ALERT_EMAIL=
# Bearer token for /metrics (Prometheus, Grafana, Uptime Kuma).
METRICS_TOKEN=
# LOG_FORMAT=json forces JSON logs in development; production always logs JSON.
LOG_LEVEL=info

# ------------------------------------------------------------ staging (#35)
# On staging: APP_ENV=staging (no real email, webhooks, mailbox sync or
# accounting pushes, and a STAGING banner), and a shared credential for the
# whole site as user:password.
# APP_ENV=staging
STAGING_BASIC_AUTH=

# Bulk import can ask a model to place unrecognised columns, read unusual
# stage wordings and flag what remarks reveal. It is off unless this key is
# set, and leaving it unset is a working configuration — the importer runs on
# rules alone and says so.
#
# Setting it sends spreadsheet content to OpenRouter and on to the model
# named below: column headers and five sample rows, and per row the PO and
# invoice numbers, amounts, and the free-text remarks. That is client names,
# deal values and commercial detail leaving our infrastructure, to a provider
# whose retention and training terms are its own. See docs/bulk-import.md.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
