# Copy to .env and adjust. Every value below is also the built-in default.
PORT=4000
DATABASE_URL=postgres://localhost:5432/cetizion_tracker
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# ---------------------------------------------------------------- sign-in
# One user, one password. AUTH_PASSWORD and SESSION_SECRET are REQUIRED when
# NODE_ENV=production — the API refuses to start without them rather than
# come up unlocked. In development both fall back so `npm run dev` just works.
AUTH_USERNAME=admin
AUTH_PASSWORD=
# Signs the session cookie. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
SESSION_SECRET=
# How long a sign-in lasts before it has to be repeated.
SESSION_TTL_HOURS=12

# ------------------------------------------------------- first admin (#18)
# Optional. Creates the first row in the users table, which records will
# belong to later. It does NOT change how anyone signs in: the API still
# authenticates with AUTH_USERNAME and AUTH_PASSWORD above, and this account
# cannot be used to sign in yet.
#
# Set all three together, or none of them:
#   none set      nothing happens, and that is the normal state today
#   all three set the FIRST admin is created, then left alone — a restart
#                 never resets its password, name or role
#   some set      the API refuses to start, because a half-set secret is a
#                 deployment that went wrong, not a reason to do nothing
#
# It only ever fills an empty seat. Once any admin who can sign in exists,
# this does nothing at all — changing BOOTSTRAP_ADMIN_EMAIL later does NOT
# create a second administrator. Adding more admins is a deliberate act
# inside the app, not an environment variable.
#
# Where it will not act it will not improvise: if the address already
# belongs to somebody — an account that is switched off, or one that is not
# an admin — nothing is reactivated, promoted or given a new password. The
# API logs a warning and starts anyway, because sign-in does not depend on
# this yet and a stale variable should not cost you a working tracker.
# Only the variables themselves being wrong (half set, not an address, a
# password under 12 characters) stops the start.
#
# The password is hashed (scrypt) before it is stored and is never logged.
# At least 12 characters. Runs after the migrations when the container
# starts; `npm run bootstrap` does the same thing by hand.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ------------------------------------------------------------- deployment
# `secure` cookies default to on in production, which means the browser will
# only send them over HTTPS. Set to false only if the app is served over
# plain HTTP — sign-in silently fails otherwise.
COOKIE_SECURE=true
# Number of reverse proxies in front of the API (Traefik, nginx, a load
# balancer). Leave at 0 when there is none: trusting a proxy that is not
# there lets a caller forge their own IP and slip past the sign-in limiter.
TRUST_PROXY=0
# Where the built front end lives. Defaults to ../web/dist.
WEB_DIST_DIR=

# -------------------------------------------------------------- documents
# Quotations and POs can carry an uploaded document, stored in Cloudinary
# (Console → Settings → API Keys). Until all three are set, uploads are
# refused; everything else works as before.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Top folder for this app's files. Use another one locally, e.g.
# cetizion-tracker-dev, so test uploads never mix with production files.
CLOUDINARY_FOLDER=cetizion-tracker
# Largest file accepted, in MB. Cloudinary's Free plan caps files at 10.
DOCUMENT_MAX_MB=10

# ------------------------------------------------------------------ dates
# Where the business is. The year in reference numbers (CTZ/QT/2026/…) and
# the date on a quotation created from a won enquiry follow this zone, not
# the server's clock, which is UTC in the container.
BUSINESS_TIME_ZONE=Asia/Kolkata

# ------------------------------------------------------------------ email
# Outgoing email: payment reminders, the finance digest, test emails.
# EMAIL_MODE=log     nothing is sent; every email is written to the log only (default)
# EMAIL_MODE=sandbox only addresses on EMAIL_ALLOWLIST receive mail (use on staging)
# EMAIL_MODE=live    sent over SMTP
EMAIL_MODE=log
EMAIL_ALLOWLIST=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Cetizion Tracker <tracker@cetizionverifica.com>
EMAIL_REPLY_TO=
EMAIL_BCC=
