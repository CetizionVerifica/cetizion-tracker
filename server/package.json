{
  "name": "cetizion-tracker-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API for the Cetizion sales, project, payment and travel tracker",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/start.js",
    "dev": "node --watch-path=src src/index.js",
    "worker": "node src/worker.js",
    "test": "node --test \"test/**/*.test.js\"",
    "db:create": "node scripts/db.js create",
    "migrate": "node scripts/db.js migrate",
    "db:upgrade": "node scripts/db.js upgrade",
    "seed": "node scripts/db.js seed",
    "seed:demo": "node scripts/db.js demo",
    "reset": "node scripts/db.js reset",
    "bootstrap": "node scripts/db.js bootstrap",
    "auth:check": "node scripts/auth-check.js",
    "fx:today": "node scripts/fx.js today",
    "readers:accuracy": "node scripts/reader-accuracy.js",
    "eval:email-docs": "node scripts/reader-accuracy.js",
    "ai:check-models": "node scripts/ai-check-models.js",
    "fx:backfill": "node scripts/fx.js backfill",
    "fx:status": "node scripts/fx.js status",
    "authz:docs": "node scripts/authz-docs.js",
    "typecheck": "tsc --noEmit",
    "ownership:backfill": "node scripts/ownership-backfill.js",
    "demo:data": "node scripts/demo-data.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pdfmake": "^0.3.11",
    "pg": "^8.13.1",
    "pg-boss": "^12.34.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "sanitize-html": "^2.17.7",
    "unpdf": "^1.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "supertest": "^7.3.0",
    "typescript": "^7.0.2"
  }
}
