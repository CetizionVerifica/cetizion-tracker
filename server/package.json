{
  "name": "cetizion-tracker-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API for the Cetizion sales, project, payment and travel tracker",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/start.js",
    "dev": "node --watch-path=src src/index.js",
    "worker": "node src/worker.js",
    "test": "node --test \"test/**/*.test.js\"",
    "db:create": "node scripts/db.js create",
    "migrate": "node scripts/db.js migrate",
    "db:upgrade": "node scripts/db.js upgrade",
    "seed": "node scripts/db.js seed",
    "seed:demo": "node scripts/db.js demo",
    "reset": "node scripts/db.js reset"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.10",
    "pdfmake": "^0.3.11",
    "pg": "^8.13.1",
    "pg-boss": "^12.32.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
