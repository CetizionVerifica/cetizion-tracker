{
  "intro": "A few questions about your organisation so we can prepare your EcoVadis proposal. Everything you tell us is treated with strict confidentiality.",
  "steps": [
    {
      "key": "basics",
      "title": "Basic details",
      "questions": [
        { "key": "customer_name", "type": "text", "label": "Customer name", "required": true, "prefill": "company.name" },
        { "key": "contact_name", "type": "text", "label": "Contact name", "required": true, "prefill": "contact.name" },
        { "key": "contact_position", "type": "text", "label": "Position" },
        { "key": "contact_email", "type": "text", "label": "Email", "required": true, "prefill": "contact.email" },
        { "key": "contact_phone", "type": "text", "label": "Phone number", "prefill": "contact.phone" },
        { "key": "website", "type": "text", "label": "Website" },
        { "key": "gst_number", "type": "text", "label": "GST number", "prefill": "company.gstin" },
        { "key": "corporate_address", "type": "textarea", "label": "Corporate address", "required": true, "prefill": "company.address" },
        {
          "key": "facilities", "type": "table", "label": "Facilities", "help": "One row per facility.", "required": true, "min_rows": 1, "max_rows": 20,
          "columns": [
            { "key": "name", "type": "text", "label": "Facility name", "required": true },
            { "key": "address", "type": "textarea", "label": "Address", "required": true }
          ]
        }
      ]
    },
    {
      "key": "people",
      "title": "People and sustainability",
      "description": "Employees at the factory, in total.",
      "questions": [
        { "key": "permanent_male", "type": "number", "label": "Permanent employees: male", "required": true, "integer": true, "min": 0 },
        { "key": "permanent_female", "type": "number", "label": "Permanent employees: female", "required": true, "integer": true, "min": 0 },
        { "key": "contractor_male", "type": "number", "label": "Contract workers: male", "required": true, "integer": true, "min": 0 },
        { "key": "contractor_female", "type": "number", "label": "Contract workers: female", "required": true, "integer": true, "min": 0 },
        { "key": "has_sustainability_function", "type": "yesno", "label": "Do you have a formal function or department for sustainability?", "required": true },
        { "key": "has_esg_report", "type": "yesno", "label": "Do you prepare a sustainability / ESG report?", "required": true },
        { "key": "esg_report_details", "type": "textarea", "label": "Please share the report and/or a weblink", "show_if": { "key": "has_esg_report", "op": "eq", "value": true } },
        { "key": "esg_report_file", "type": "file", "label": "The report, if you would rather upload it", "show_if": { "key": "has_esg_report", "op": "eq", "value": true } }
      ]
    },
    {
      "key": "site",
      "title": "Site and certifications",
      "questions": [
        { "key": "plant_area_sqm", "type": "number", "label": "Plant area (sq. m)", "required": true, "min": 0 },
        { "key": "built_up_area_sqm", "type": "number", "label": "Built-up area (sq. m)", "min": 0 },
        { "key": "main_products", "type": "textarea", "label": "Main products / services", "required": true },
        {
          "key": "certifications", "type": "checkbox", "label": "Valid certifications and activities", "help": "Tick each you hold.",
          "options": [
            { "key": "iso_14001", "label": "ISO 14001" },
            { "key": "sa_8000", "label": "SA 8000" },
            { "key": "iso_45001", "label": "ISO 45001" },
            { "key": "iso_27001", "label": "ISO 27001" },
            { "key": "iso_37001", "label": "ISO 37001" },
            { "key": "external_assurance_esg", "label": "External assurance of ESG / sustainability report" },
            { "key": "iso_50001", "label": "ISO 50001" },
            { "key": "external_verification_ghg", "label": "External verification of greenhouse gas emissions" },
            { "key": "iso_20400", "label": "ISO 20400" },
            { "key": "product_lca", "label": "Product life cycle assessment" },
            { "key": "cdp", "label": "CDP (with your score in Climate Change, Water and Forestry)" },
            { "key": "other_esg", "label": "Other ESG certification" },
            { "key": "zero_waste_to_landfill", "label": "Zero Waste to Landfill (ZWL)" },
            { "key": "zero_liquid_discharge", "label": "Zero Liquid Discharge (ZLD)" },
            { "key": "great_place_to_work", "label": "Great Place to Work" },
            { "key": "other_activity", "label": "Other (please specify)" }
          ]
        },
        { "key": "other_esg_certification", "type": "text", "label": "Which other ESG certification?", "show_if": { "key": "certifications", "op": "eq", "value": "other_esg" } },
        { "key": "other_activity_details", "type": "text", "label": "Which other certification or activity?", "show_if": { "key": "certifications", "op": "eq", "value": "other_activity" } },
        {
          "key": "certificate_validity", "type": "table", "label": "Valid until (optional)", "help": "The expiry date of each certificate you ticked, where you have it.", "max_rows": 16,
          "show_if": { "key": "certifications", "op": "answered" },
          "columns": [
            { "key": "certification", "type": "text", "label": "Certification", "required": true },
            { "key": "valid_until", "type": "date", "label": "Valid until", "required": true }
          ]
        }
      ]
    },
    {
      "key": "ecovadis",
      "title": "EcoVadis and your plans",
      "questions": [
        { "key": "past_assessment", "type": "yesno", "label": "Did you undergo an EcoVadis assessment in the past?", "required": true },
        { "key": "ecovadis_score", "type": "number", "label": "What was the total score?", "required": true, "min": 0, "max": 100, "show_if": { "key": "past_assessment", "op": "eq", "value": true } },
        { "key": "assessment_date", "type": "date", "label": "Validity / assessment date", "required": true, "show_if": { "key": "past_assessment", "op": "eq", "value": true } },
        {
          "key": "assessment_level", "type": "radio", "label": "Assessment level", "show_if": { "key": "past_assessment", "op": "eq", "value": true },
          "options": [
            { "key": "unit", "label": "Unit level" },
            { "key": "group", "label": "Group level (more than one unit)" }
          ]
        },
        {
          "key": "medal_target", "type": "radio", "label": "Target for the next assessment / medal", "required": true, "show_if": { "key": "past_assessment", "op": "eq", "value": true },
          "options": [
            { "key": "bronze", "label": "Bronze" },
            { "key": "silver", "label": "Silver" },
            { "key": "gold", "label": "Gold" },
            { "key": "platinum", "label": "Platinum" }
          ]
        },
        { "key": "receives_awards", "type": "yesno", "label": "Do you receive awards and recognition in environment, safety, energy efficiency, ESG, supply chain, corporate governance or CSR?" },
        { "key": "awards_details", "type": "textarea", "label": "List them: award, issuing organisation, month and year", "show_if": { "key": "receives_awards", "op": "eq", "value": true } },
        {
          "key": "commitments", "type": "checkbox", "label": "Commitments (tick if applicable)",
          "options": [
            { "key": "un_global_compact", "label": "UN Global Compact" },
            { "key": "sbti", "label": "Science Based Targets initiative (SBTi)" },
            { "key": "psci", "label": "Pharmaceutical Supply Chain Initiative" },
            { "key": "other", "label": "Others" }
          ]
        },
        { "key": "commitments_other", "type": "text", "label": "Which other commitments?", "show_if": { "key": "commitments", "op": "eq", "value": "other" } },
        { "key": "desired_timeline", "type": "text", "label": "Desired timeline", "required": true },
        { "key": "major_customers", "type": "textarea", "label": "Major customers" },
        {
          "key": "other_services", "type": "checkbox", "label": "Any additional services you are interested in",
          "options": [
            { "key": "psci", "label": "Pharmaceutical Supply Chain Initiative" },
            { "key": "asi", "label": "Aluminium Stewardship Initiative (ASI)" },
            { "key": "copper_mark", "label": "Copper Mark" },
            { "key": "responsible_steel", "label": "Responsible Steel" },
            { "key": "cdp", "label": "CDP" },
            { "key": "iso_37001", "label": "ISO 37001" },
            { "key": "iso_14001", "label": "ISO 14001" },
            { "key": "iso_45001", "label": "Health & safety ISO 45001" },
            { "key": "iso_14044", "label": "ISO 14044" },
            { "key": "product_lca", "label": "Product life cycle assessment certification" },
            { "key": "zero_waste_to_landfill", "label": "Zero waste to landfill certification" },
            { "key": "pas_2060", "label": "Carbon neutrality as per PAS 2060" },
            { "key": "sa_8000", "label": "SA 8000" },
            { "key": "bexsafe", "label": "Bexsafe" },
            { "key": "sustainability_report", "label": "Sustainability report" },
            { "key": "iso_50001", "label": "ISO 50001" }
          ]
        }
      ]
    }
  ]
}
